{
  "name": "rory-duff-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src tests scripts *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app src tests scripts *.json *.mjs *.ts .github/workflows/*.yml docs/**/*.md",
    "format:check": "prettier --check app src tests scripts *.json *.mjs *.ts docs/**/*.md",
    "test": "node --test --experimental-test-isolation=none tests/unit/*.test.ts",
    "test:rules": "firebase emulators:exec --project demo-sacred-path --only firestore,storage \"node --test --experimental-test-isolation=none tests/rules/*.test.ts\"",
    "test:smoke": "firebase emulators:exec --project demo-sacred-path --only auth,firestore,storage \"playwright test\"",
    "admin:emulator": "node scripts/create-emulator-admin.ts"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase": "12.18.0",
    "firebase-tools": "15.29.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
